// KazBars - the host: the shared runtime (KazBarsClock, KazBarsWorld), the module registry, preview mode, the
// archive and SlotAlive. Every module, the grids included, is reached through the KazBarsModule lifecycle and World;
// a build that gates one out drops its lines here and nothing else.
class KazBars {

    private var rootClip:MovieClip;
    private var config:Object;
    private var clock:KazBarsClock;
    private var world:KazBarsWorld;
    private var grids:KazBarsGrids;
    private var previewMode:Boolean;
    private var previewArmed:Boolean;
    private var down:Boolean;     // cleaned up by a deactivation, not yet built again
    private var lastShiftDown:Number;
    private var lastCtrlDown:Number;
    private var lastAltDown:Number;

//#if CONSOLE
    private var console:KazBarsConsole;
//#end
    private var ppanel:KazBarsPreviewPanel;
//#if CAST
    private var castTimer:KazBarsCastTimer;
//#end
//#if INS
    private var inspect:KazBarsInspect;
//#end
//#if ONS
    private var onslaught:KazBarsOnslaught;
//#end
//#if SW
    private var stopwatch:KazBarsStopwatch;
//#end
//#if PLATE
    private var overhead:KazBarsOverhead;
//#end

    // Every module compiled into this build, in registration (z) order.
    private var modules:Array;

    private var keyListener:Object;


    public function KazBars(root:MovieClip) {
        rootClip = root;
        modules = new Array();
        previewMode = false;
        previewArmed = true;
        down = false;
        lastShiftDown = 0;
        lastCtrlDown = 0;
        lastAltDown = 0;
        clock = new KazBarsClock(rootClip);
        var d:Object = KazBarsData.init();
        world = new KazBarsWorld(clock, d);

//#if CONSOLE
        console = new KazBarsConsole(rootClip);
//#end
        grids = new KazBarsGrids(rootClip);
        ppanel = new KazBarsPreviewPanel(this, rootClip);
//#if CAST
        castTimer = new KazBarsCastTimer(rootClip);
//#end
//#if INS
        inspect = new KazBarsInspect(rootClip);
//#end
//#if ONS
        onslaught = new KazBarsOnslaught(rootClip);
//#end
//#if SW
        stopwatch = new KazBarsStopwatch(rootClip);
//#end
//#if PLATE
        overhead = new KazBarsOverhead(rootClip);
//#end

        // Registration order is z-order: onLoad builds in this order, so later
        // modules stack above earlier ones (the console on top). The control
        // panel's row order is enterPreview()'s addExtra sequence, not this.
        modules.push(grids);
//#if PLATE
        modules.push(overhead);
//#end
//#if INS
        modules.push(inspect);
//#end
//#if CAST
        modules.push(castTimer);
//#end
//#if ONS  // its host clip is made in create(), so its anchors keep this slot, under the console
        modules.push(onslaught);
//#end
//#if SW
        modules.push(stopwatch);
//#end
//#if CONSOLE
        modules.push(console);
//#end

        ppanel.configure(d.PF);
        grids.configure(d, world, clock);
//#if PLATE
        overhead.configure(d, world, clock);
//#end
//#if CONSOLE  // the control panel's configure above is never gated; the console's follows its build gate
        console.configure(d.CON);
//#end
//#if CONBUFFS  // each console tab is its own class under its own gate; the console orders them by d.CON.tabs
        console.add(new KazBarsConBuffs());
//#end
//#if CONCASTS
        console.add(new KazBarsConCasts());
//#end
//#if CONSOLE
        console.follow(world);
//#end
//#if CAST
        castTimer.configure(d.CAST, world, clock);
//#end
//#if INS
        inspect.configure(d.INS, world, clock);
//#end
//#if ONS
        onslaught.configure(d.ONS, world, clock);
//#end
//#if SW
        stopwatch.configure(d.SW);
//#end
    }

    private function handleKeyDown():Void {
        // Recency window, not Key.isDown: alt-tab leaves modifiers stuck-down in Flash.
        var c:Number = Key.getCode();
        var t:Number = getTimer();
        if (c == 16) lastShiftDown = t;
        else if (c == 17) lastCtrlDown = t;
        else if (c == 18) lastAltDown = t;
        var W:Number = 600;
        if (t - lastShiftDown < W && t - lastCtrlDown < W && t - lastAltDown < W) {
            if (previewArmed) { previewArmed = false; if (!previewMode) enterPreview(); else exitPreview(); }
        }
    }

    private function handleKeyUp():Void {
        if (!(Key.isDown(16) && Key.isDown(17) && Key.isDown(18))) previewArmed = true;
    }

    private function enterPreview():Void {
        if (previewMode) return;
        previewMode = true;
        ppanel.begin();
        // previewOn runs first and must leave module state alone -- a display
        // dresses itself for dragging, no more.
        var mi:Number = 0;
        while (mi < modules.length) {
            var m:KazBarsModule = modules[mi];
            m.previewOn();
            mi++;
        }
        var i:Number;
        for (i = 0; i < grids.views.length; i++) ppanel.addGrid(grids.views[i]);
        // Explicit adds, not a modules loop: this sequence IS the panel's Tools
        // row order, decoupled from the registration order above (which is
        // z-order). Each row is seeded from what its module is doing right now,
        // so the panel caches no state of its own.
//#if CAST
        ppanel.addExtra(castTimer.previewLabel(), castTimer.previewKey(), castTimer.isActive());
//#end
//#if INS
        ppanel.addExtra(inspect.previewLabel(), inspect.previewKey(), inspect.isActive());
//#end
//#if ONS
        ppanel.addExtra(onslaught.previewLabel(), onslaught.previewKey(), onslaught.isActive());
//#end
//#if CONSOLE
        ppanel.addExtra(console.previewLabel(), console.previewKey(), console.isActive());
//#end
//#if SW
        ppanel.addExtra(stopwatch.previewLabel(), stopwatch.previewKey(), stopwatch.isActive());
//#end
        // Last, so the control panel sits on top of everything it controls.
        ppanel.show();
    }

    private function exitPreview():Void {
        if (!previewMode) return;
        previewMode = false;
        saveAll();
        // Panel first -- its position is already captured. Nothing is restored
        // on the way out: the checks are the settings now.
        ppanel.destroy();
        var mi:Number = 0;
        while (mi < modules.length) {
            var m:KazBarsModule = modules[mi];
            m.previewOff();
            mi++;
        }
    }

    // Named dispatcher for the control panel's extra rows -- the checkbox knows
    // a key, each stub has its own idea of what hiding means.
    public function previewToggle(key:String, shown:Boolean):Void {
        var mi:Number = 0;
        while (mi < modules.length) {
            var m:KazBarsModule = modules[mi];
            if (m.previewKey() == key) m.setActive(shown);
            mi++;
        }
    }

    private function cleanup():Void {
        previewMode = false;
        down = true;
        if (keyListener != null) { Key.removeListener(keyListener); keyListener = null; }
        ppanel.destroy();
        var mi:Number = 0;
        while (mi < modules.length) {
            var m:KazBarsModule = modules[mi];
            m.cleanup();
            mi++;
        }
        world.stop();
        clock.stop();
    }

    public function onLoad():Void {
        down = false;
        Stage.showMenu = false;
        // Double-init protection: each module's create() cleans up after itself.
        if (keyListener != null) Key.removeListener(keyListener);
        var self:KazBars = this;
        keyListener = {};
        keyListener.onKeyDown = function() { self.handleKeyDown(); };
        keyListener.onKeyUp = function() { self.handleKeyUp(); };
        Key.addListener(keyListener);
        // Every module builds now, in whatever state it opens at login by
        // default -- what a first-ever session gets, before any archived state
        // exists to say otherwise. loadAll reconciles once it arrives.
        var mi:Number = 0;
        while (mi < modules.length) {
            var m:KazBarsModule = modules[mi];
            m.create();
            mi++;
        }
        try {
            com.GameInterface.Game.CharacterBase.SignalClientCharacterAlive.Connect(world.start, world);
            if (com.GameInterface.Game.Character.GetClientCharacter() != null) world.start();
        } catch (e:Object) {}
    }

    // The archive, read and written in one place each. Both persist paths
    // (preview exit and deactivate) call saveAll, so a new key can be forgotten
    // on one side, not three. A module's own loadState owns its whole archive
    // dance: its keys, then whatever rebuild they imply.
    private function loadAll():Void {
        if (config == null) return;
        ppanel.loadState(config);
        var mi:Number = 0;
        while (mi < modules.length) {
            var m:KazBarsModule = modules[mi];
            m.loadState(config);
            mi++;
        }
    }

    private function saveAll():Void {
        if (config == null) return;
        ppanel.saveState(config);
        var mi:Number = 0;
        while (mi < modules.length) {
            var m:KazBarsModule = modules[mi];
            m.saveState(config);
            mi++;
        }
    }

    // An activation after a deactivation that kept this file loaded finds every module cleaned up: it builds them
    // again, as a load would (onLoad), before the archive places them.
    public function OnModuleActivated(archive:Object):Void {
        config = archive;
        if (down) onLoad();
        loadAll();
    }

    public function OnModuleDeactivated():Object {
        saveAll();
        try { com.GameInterface.Game.CharacterBase.SignalClientCharacterAlive.Disconnect(world.start, world); } catch (e:Object) {}
        cleanup();
        return config;
    }

}
